@model IEnumerable<Mission06_Hoopes.Models.Movie>
@{
    ViewData["Title"] = "Movie Collection";
}

<h1 class="display-5">Joel's Movie Collection</h1>

<p>
    <a class="btn btn-primary" asp-action="AddMovie">Add New Movie</a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
    <tr>
        <th>Title</th>
        <th>Year</th>
        <th>Category</th>
        <th>Edited</th>
        <th>Copied</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var m in Model)
    {
        <tr>
            <td>@m.Title</td>
            <td>@m.Year</td>
            <td>@(m.Category?.CategoryName ?? "—")</td>
            <td>@(m.Edited ? "Yes" : "No")</td>
            <td>
                @if (m.CopiedToPlex)
                {
                    <span class="badge bg-success">Yes</span>
                }
                else
                {
                    <span class="text-muted">No</span>
                }
            </td>
            <td>
                <a class="btn btn-sm btn-secondary" asp-action="Edit" asp-route-id="@m.MovieId">Edit</a>
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@m.MovieId">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>